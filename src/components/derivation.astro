---
const { title = "Show derivation" } = Astro.props;
---

<details style="margin: 1rem 0; padding: 0.75rem 1rem; border: 1px solid #d1d5db; border-radius: 8px; background: white;">
  <summary style="cursor: pointer; font-weight: 600;">
    <slot name="summary">Show derivation</slot>
  </summary>
  <div style="margin-top: 1rem;">
    <slot />
  </div>
</details>