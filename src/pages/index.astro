---
import NavTree from '../components/nav-tree.astro';
import { notesTree } from '../data/notes-tree';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Physics Notes</title>
	</head>
	<body style="font-family: Arial, sans-serif; margin: 0; padding: 2rem; background: #f8fafc; color: #111827;">
		<main style="max-width: 900px; margin: 0 auto;">
			<h1>Physics Notes</h1>
			<p>Browse by topic:</p>

			<NavTree nodes={notesTree} />
		</main>
	</body>
</html>